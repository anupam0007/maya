# ==========================================================================
# Maya Studio — booking configuration
#
# Copy this file to .env and fill in ONE of the two options below.
# Check what the site thinks it can do at any time:  /api/health
# ==========================================================================


# --------------------------------------------------------------------------
# OPTION A — full Google  (recommended)
#
#   · a NEW Google Meet link for every booking
#   · a real calendar event, so Google also sends both of you the invite
#   · booked slots are read live from your calendar and greyed out
#
# Takes about ten minutes once. Run "npm run auth" and follow the README.
# --------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=


# --------------------------------------------------------------------------
# OPTION B — Gmail App Password  (quicker, about three minutes)
#
#   · real email to the client and to you, carrying a Meet link
#   · uses ONE fixed Meet room for every call (your personal meeting room)
#   · no calendar event, so slots are NOT de-duplicated
#
# 1. Turn on 2-Step Verification: myaccount.google.com/security
# 2. Create an App Password:      myaccount.google.com/apppasswords
#    (name it "Maya site" — you get a 16-character password)
# 3. Get your permanent Meet room: open meet.google.com, click
#    "New meeting" → "Create a meeting for later", and copy the link.
# --------------------------------------------------------------------------
GMAIL_USER=anupamgowda1999@gmail.com
GMAIL_APP_PASSWORD=
MEET_LINK=


# --------------------------------------------------------------------------
# Always set these
# --------------------------------------------------------------------------
# Where the studio copy of every booking goes.
OWNER_EMAIL=anupamgowda1999@gmail.com

# Only used by Option A.
CALENDAR_ID=primary
